# Copy to .env for local development.
# On AWS, set this on the container to the RDS Postgres URL, ending in ?sslmode=require.
DATABASE_URL="postgresql://YOUR_MAC_USER@localhost:5432/stripes_app"

# Signs the session cookie. At least 32 characters; make one with: openssl rand -base64 32
# On AWS, set a different random value on the container and keep it secret.
AUTH_SECRET="replace-with-the-output-of-openssl-rand-base64-32"
