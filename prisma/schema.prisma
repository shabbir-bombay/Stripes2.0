// Data model. Rules Prisma can't express (email domain, one active ride per student, ...)
// are added as SQL in the migrations.

generator client {
  provider = "prisma-client"
  output   = "../lib/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  student
  driver
  admin
}

enum ServiceMode {
  automatic
  on
  off
}

enum RideStatus {
  requested
  assigned
  en_route
  arrived
  in_progress
  completed
  canceled
  no_show
}

enum PenaltyPointStatus {
  pending
  approved
  rejected
}

enum NotificationType {
  ride_assigned
  driver_arrived
  ride_canceled
  penalty_point
}

/// Email must end in @pacific.edu or @u.pacific.edu (CHECK in the migration).
model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String
  name         String
  role         Role           @default(student)
  suspended    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  driver       DriverProfile?
  rides        Ride[]
  penaltyPoints          PenaltyPoint[] @relation("penaltyPointStudent")
  requestedPenaltyPoints PenaltyPoint[] @relation("penaltyPointRequester")
  decidedPenaltyPoints   PenaltyPoint[] @relation("penaltyPointDecider")
  notifications          Notification[]
}

/// Exists for every user with the driver role, and stays if they stop being one so old rides keep their call sign.
/// `cartId` is set only while the driver is on shift.
model DriverProfile {
  userId     String    @id @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The only driver identity a student sees, e.g. "Cart 3".
  callSign   String    @unique
  /// Unique: one driver per cart.
  cartId     String?   @unique @db.Uuid
  cart       Cart?     @relation(fields: [cartId], references: [id])
  shiftStart DateTime?
  lat        Float?
  lng        Float?
  positionAt DateTime?
  rides      Ride[]
}

/// Seats include the driver's seat.
model Cart {
  id     String         @id @default(uuid()) @db.Uuid
  number String         @unique
  seats  Int
  active Boolean        @default(true)
  driver DriverProfile?
}

model Stop {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  lat      Float
  lng      Float
  active   Boolean @default(true)
  pickups  Ride[]  @relation("pickup")
  dropoffs Ride[]  @relation("dropoff")
}

/// Status changes go through one function (week 2), never a direct update.
/// One active ride per student (partial unique index in the migration).
model Ride {
  id           String         @id @default(uuid()) @db.Uuid
  studentId    String         @db.Uuid
  student      User           @relation(fields: [studentId], references: [id])
  driverId     String?        @db.Uuid
  driver       DriverProfile? @relation(fields: [driverId], references: [userId])
  pickupId     String         @db.Uuid
  pickup       Stop           @relation("pickup", fields: [pickupId], references: [id])
  dropoffId    String         @db.Uuid
  dropoff      Stop           @relation("dropoff", fields: [dropoffId], references: [id])
  partySize    Int
  status       RideStatus     @default(requested)
  requestedAt  DateTime       @default(now())
  assignedAt   DateTime?
  arrivedAt    DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  cancelReason String?
  /// The cart the driver had when given the ride, so history keeps it after the shift ends.
  cartNumber   String?
  feedback      Feedback?
  penaltyPoints PenaltyPoint[]
  notifications Notification[]

  @@index([status])
  @@index([studentId])
  @@index([driverId])
}

/// Weekly opening hours in campus time (America/Los_Angeles). `end` before `start` runs past midnight.
model ServiceRule {
  id    String @id @default(uuid()) @db.Uuid
  /// 0 = Sunday ... 6 = Saturday, the day the window starts.
  day   Int
  /// "HH:MM"
  start String
  end   String
}

/// One row (id 1, CHECK in the migration): how the admin set the service.
/// `automatic` follows the ServiceRule hours; `on` and `off` override them.
model Service {
  id        Int         @id @default(1)
  mode      ServiceMode @default(automatic)
  updatedAt DateTime    @default(now()) @updatedAt
}

/// A driver's request waits for an admin; an admin's own point is approved at once. Students only see approved ones.
/// One live point per ride (partial unique index in the migration); a rejected one may be asked for again.
model PenaltyPoint {
  id            String             @id @default(uuid()) @db.Uuid
  studentId     String             @db.Uuid
  student       User               @relation("penaltyPointStudent", fields: [studentId], references: [id])
  rideId        String?            @db.Uuid
  ride          Ride?              @relation(fields: [rideId], references: [id], onDelete: SetNull)
  reason        String
  status        PenaltyPointStatus @default(pending)
  /// Null once the person who asked for it has been deleted; the point stays on the student's record.
  requestedById String?            @db.Uuid
  requestedBy   User?              @relation("penaltyPointRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedById   String?            @db.Uuid
  decidedBy     User?              @relation("penaltyPointDecider", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  createdAt     DateTime           @default(now())

  @@index([studentId, status])
  @@index([status, createdAt])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  text      String
  rideId    String?          @db.Uuid
  ride      Ride?            @relation(fields: [rideId], references: [id], onDelete: SetNull)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

/// One per completed ride. The rating is 1 to 5 (CHECK in the migration).
model Feedback {
  rideId    String   @id @db.Uuid
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}
