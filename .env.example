# Copy to .env for local development.
# On AWS, set this on the container to the RDS Postgres URL, ending in ?sslmode=verify-full&sslrootcert=<RDS CA bundle>.
DATABASE_URL="postgresql://YOUR_MAC_USER@localhost:5432/stripes_app"

# Signs the session cookie. At least 32 characters; make one with: openssl rand -base64 32
# On AWS, set a different random value on the container and keep it secret.
AUTH_SECRET="replace-with-the-output-of-openssl-rand-base64-32"

# Optional. With both set, Amazon Cognito checks passwords and emails sign-up and password-reset codes; the server also
# needs AWS credentials allowed to call cognito-idp Admin* on the pool. Without them, passwords are hashed in the
# database and reset codes are printed in the server log.
# COGNITO_USER_POOL_ID=""
# COGNITO_CLIENT_ID=""

# Optional. Push alerts. Make a key pair with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a URL or mailto: the push services can contact.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT=""
